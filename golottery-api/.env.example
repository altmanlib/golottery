POSTGRES_DB=golottery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_PORT=15436

DATABASE_URL=postgres://postgres:secret@127.0.0.1:15436/golottery?sslmode=disable
REDIS_URL=redis://127.0.0.1:57379/0
APP_HOST=127.0.0.1
APP_PORT=5568
SESSION_SECRET=replace-with-at-least-32-random-characters

# Seeds the first platform operator when platform_users is empty; ignored afterwards.
# Hash: printf '%s' 'your-password' | go run ./cmd/golottery hash-password
# Keep the single quotes: the argon2id hash contains '$'.
PLATFORM_USER=ops
PLATFORM_PASSWORD_HASH='replace-with-argon2id-hash'

# Optional. Comma-separated CIDRs allowed to forward X-Request-Id.
# TRUSTED_PROXIES=127.0.0.1/32

# ScopeApp defaults. Override here or with `golottery settings set`.
# CONSOLE_SESSION_TTL=12h
# HOST_SESSION_TTL=12h
# PLATFORM_SESSION_TTL=8h
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW=15m

# WeChat mini program (P-13). Empty values leave everything working except the
# mini program code, which answers 503 E_WECHAT_NOT_CONFIGURED.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# release, trial or develop; unreleased versions skip the published-page check.
# WECHAT_ENV_VERSION=release
# WECHAT_API_BASE=https://api.weixin.qq.com
