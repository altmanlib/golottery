POSTGRES_DB=golottery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_PORT=15436

DATABASE_URL=postgres://postgres:secret@127.0.0.1:15436/golottery?sslmode=disable
APP_HOST=127.0.0.1
APP_PORT=5568
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. Comma-separated CIDRs allowed to forward X-Request-Id.
# TRUSTED_PROXIES=127.0.0.1/32

# ScopeApp defaults. Override here or with `golottery settings set`.
# CONSOLE_SESSION_TTL=12h
# HOST_SESSION_TTL=12h
# PLATFORM_SESSION_TTL=8h
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW=15m
